# Laravel is contacted only by the server-side BFF and Server Components.
API_UPSTREAM_URL=http://localhost:8000

# Upstream Laravel cookie name and isolated browser-facing Platform cookie names.
LARAVEL_SESSION_COOKIE=laravel_session
PLATFORM_SESSION_COOKIE=platform_admin_session
PLATFORM_XSRF_COOKIE=platform_admin_xsrf

# Must match backend-api AUTH_PROXY_SECRET in production (32+ characters).
AUTH_PROXY_SECRET=
